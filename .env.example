# Copy to .env and fill in. Docker Compose reads it automatically.

# Database password (required). Use something long and random.
POSTGRES_PASSWORD=

# Port sAIles is published on, on the host.
SAILES_PORT=8080

# Optional: create the first account at start-up instead of through the setup screen.
SAILES_ADMIN_EMAIL=
SAILES_ADMIN_PASSWORD=
SAILES_ADMIN_NAME=

# Load fictional demo data on first start (only when the database is empty).
SAILES_SEED_DEMO=false

# Set to true when sAIles is served over HTTPS (e.g. behind Caddy, Traefik or nginx).
SAILES_SECURE_COOKIES=false

# Only needed when running the server outside Docker (cargo run):
# DATABASE_URL=postgres://sailes:password@localhost:5432/sailes
# SAILES_WEB_DIR=web/dist
